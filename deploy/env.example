# Copy to /etc/sem-meter/env on the server (NOT into the repo checkout).
# Owner root:sem-meter, mode 640 — readable only by root and the sem-meter
# service user:
#
#   sudo install -d -m 750 -o root -g sem-meter /etc/sem-meter
#   sudo install -m 640 -o root -g sem-meter deploy/env.example /etc/sem-meter/env
#   sudo $EDITOR /etc/sem-meter/env   # fill in real values below
#
# Same variables as the repo-root .env used for local dev — see
# validate_semmeter_mqtt.py / README.md.

# Admin account created on first start (its one-time password is printed in
# the server log). Required for a fresh install; ignored once the account exists.
ADMIN_EMAIL=you@example.com
SEMMETER_USER=you@example.com
SEMMETER_PASS=your-sem-app-password
DEVICE_SN=YOUR_DEVICE_SERIAL

# Usage alerts (push notifications) — optional. Without these set, the app
# runs fine, the notification bell just has nothing to subscribe to.
# Generate a pair once (from server/, where web-push is installed) with:
#   node --input-type=module -e "import w from 'web-push'; console.log(w.generateVAPIDKeys())"
# and keep the private key secret — anyone with it could push
# notifications as this app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Password reset email — optional. Without these set, the app runs fine;
# forgot-password links just fall back to being logged server-side only
# (journalctl -u sem-meter) instead of emailed. Uses Cloudflare's SMTP
# relay — the SMTP username is always the literal string "api_token", with
# a Cloudflare API token as the password. MAIL_FROM must be a sender
# address/domain authorized under that Cloudflare account.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_TOKEN=
MAIL_FROM=you@example.com
